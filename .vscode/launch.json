{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WebAPI: Debug",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/webapi",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/apps/webapi/src/server.ts",
      "envFile": "${workspaceFolder}/.env",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Webapp: Dev Server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/webapp",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Full stack: Debug WebAPI",
      "configurations": ["WebAPI: Debug", "Webapp: Dev Server"],
      "stopAll": true
    }
  ]
}
